{
  "name": "ultra-instinct",
  "version": "2.0.0",
  "description": "A lightweight cross-client workflow runtime for coding agents",
  "type": "module",
  "main": ".opencode/index.mjs",
  "exports": {
    ".": "./.opencode/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node validation/test.mjs",
    "validate": "node validation/cli.mjs",
    "validate:portable": "node validation/cli.mjs portable",
    "validate:claude": "node validation/cli.mjs claude",
    "validate:codex": "node validation/cli.mjs codex",
    "validate:opencode": "node validation/cli.mjs opencode",
    "check": "npm run validate && npm test",
    "eval": "node evals/run.mjs",
    "eval:compare": "node evals/compare.mjs",
    "eval:report": "node evals/report.mjs",
    "eval:harbor:prepare": "node evals/harbor/prepare.mjs",
    "eval:harbor:analyze": "node evals/harbor/analyze.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "ajv": "8.20.0"
  },
  "license": "MIT",
  "repository": "https://github.com/XSIRIX/ultra-instinct"
}
